#!/bin/sh
# Local pre-commit gate: the fast half of scripts/check.sh, before every commit.
#   npm run check = typecheck (tsc) + lint (eslint) + boundary law + CSS tokens + SPA build
# The test suites run in scripts/check.sh, which the pre-push hook runs. Bypass (rare) with
# `git commit --no-verify`.
exec npm run check
